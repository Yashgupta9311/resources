   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Children of Suai Loro village on the beach seen her at school Beneficiaries of the  WFP school feeding program which aims at feeding children daily meals composed of rice and beans. Fishermen live a very poor life due to limited fishing capacities and few fish caught. Women stay home, often uneducated to take care of households. Children go to school when they can - not daily. Photos by Martine Perret/UNMIT 18 November 2008</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>UN Photo/Martine Perret</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Peacekeeping - UNMIT</rdf:li>
    </rdf:Alt>
   </dc:title>
