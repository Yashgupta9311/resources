   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Peacekeeping - UNAMID</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Albert Gonzalez Farran, UNAMID</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">18 February 2014. Abu Shouk: Women in Abu Shouk camp for Internally Displaced Persons (IDP), North Darfur, receive English classes conducted by volunteer teachers and facilitated by the UNAMID police. Nearly 100 women, mostly adult and mothers, attend these classes three times a week in a school in the camp with materials (exercise books, notebooks, blackboards and chalks) provided by the UNAMID police section.  &#xA;Photo by Albert GonzÃ¡lez Farran, UNAMID</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>UN Photo/Albert Gonzalez Farran</rdf:li>
    </rdf:Seq>
   </dc:creator>
